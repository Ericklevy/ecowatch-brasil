# ==========================================
# ECOWATCH BRASIL - EXEMPLO DE VARIÁVEIS (.env.example)
# Copie este arquivo para .env e preencha suas chaves/senhas
# ==========================================

# E-mail (Gmail SMTP)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=seu_email@gmail.com
SPRING_MAIL_PASSWORD=sua_senha_de_aplicativo
NOTIFICATION_EMAIL_DEFAULT_TO=seu_email@gmail.com

# PostgreSQL
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/ecowatch
SPRING_DATASOURCE_USERNAME=ecowatch
SPRING_DATASOURCE_PASSWORD=sua_senha_postgres

# RabbitMQ
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=guest
SPRING_RABBITMQ_PASSWORD=guest

# Apache Kafka
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Redis
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379

# Agendamento Automático (Cron Job - 6 campos Spring)
# Padrão: a cada hora cheia (0 0 * * * *)
# Para testes: a cada 5 minutos (0 */5 * * * *)
SCHEDULER_CRON=0 0 * * * *

# ==========================================
# APIs PÚBLICAS DE DADOS AMBIENTAIS
# ==========================================

# Open-Meteo Air Quality (GRATUITO - sem chave, sem cadastro)
# Documentação: https://open-meteo.com/en/docs/air-quality-api
# A URL já está configurada como padrão — não precisa alterar.
# api.open-meteo.air-quality-url=https://air-quality-api.open-meteo.com/v1

# INPE / BDQueimadas (Focos de Incêndio)
# Acesso: Crie conta em https://queimadas.dgi.inpe.br/queimadas/bdqueimadas/
# Deixar como "SIMULADO" usa estimativa climática inteligente como fallback.
INPE_URL=SIMULADO

# CEMADEN (Alertas de Enxurrada e Deslizamentos)
# Acesso: https://www.cemaden.gov.br/ — contate a equipe técnica para API REST.
# Deixar como "SIMULADO" usa estimativa baseada em condições climáticas críticas.
CEMADEN_URL=SIMULADO

# ANA - Agência Nacional de Águas (Nível dos Rios / HidroWeb)
# Acesso: https://www.snirh.gov.br/hidroweb/ — dados abertos, sem autenticação.
# Exemplo: https://www.snirh.gov.br/hidroweb/rest/api/documento/convencionais?tipo=3&codEstacao=13600002
# Deixar como "SIMULADO" usa estimativa de nível baseada em precipitação acumulada.
ANA_URL=SIMULADO

